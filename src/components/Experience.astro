        date: '2021-2022',
        title: 'Costs Department Trainee',
        company: 'Klabin',
        description: 'Supported cost analysis processes through budget tracking, inventory control, and financial reporting to improve visibility and decision-making within the operations team.',
    }
]
---

<ol class="relative mt-16">   
    {
        EXPERIENCE.map((experience) =>(
            <li class="">
                <ExperienceItem {...experience}/>
