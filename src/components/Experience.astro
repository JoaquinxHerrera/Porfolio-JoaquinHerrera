            { label: 'CaryHealth', url: 'https://www.cary.health/' },
            { label: 'CaryHealth Old', url: 'https://caryhealth-bright.vercel.app/index.html' },
            { label: 'Why Am I Up', url: 'https://www.whyamiup.com/' }, 
            { label: 'CaryRx', url: 'https://caryrx.vercel.app/' },
            { label: 'OneDash', url: 'https://www.onedashengine.com/' }
        ],
    },
    /*
    {
        date: '07-2024',
        title: 'Frontend Developer',
        company: 'Igrowker',
        description: 'Participated in the frontend development of Talent Place, a platform connecting junior workers with employers, using React, Vite, JavaScript, and Bootstrap CSS.',
        links: [{label: 'Know More', url: 'https://talentplace.vercel.app/'}],
    },*/
    {
        date: '06-2023',
        title: 'Landing Page development',
        company: 'Boid',
        description: 'Developed a responsive landing page using HTML and CSS for a client project, translating design requirements into a clean, production-ready website with a strong focus on responsiveness and user experience.',
        links: [{label: 'Know More', url: 'https://boid.com/'}],
    },
    {
        date: '08-2022 - 04-2023',
        title: 'Client Financial Management Analyst',
        company: 'Accenture',
        description: 'Managed and analyzed financial performance of contracts with US-based clients, monitoring budgets, costs, and revenue metrics to support business decision-making and ensure contract profitability.',
    },
